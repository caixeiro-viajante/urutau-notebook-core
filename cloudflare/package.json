{
  "name": "@cura-em-movimento/urutau-notebook-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "test": "node --test tests/core.test.mjs",
    "types": "wrangler types --env-interface Env",
    "check": "npm run types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --keep-vars",
    "migrate": "wrangler d1 migrations apply urutau-notebook-core --remote"
  },
  "devDependencies": { "typescript": "5.9.3", "wrangler": "4.92.0" }
}
